    {
        id ronin-idiomatization
        title "Idiomatize Ronin while preserving Ninja compatibility"
        children (
            {
                id ronin-compatibility-contract
                title "Codify Ronin identity and Ninja compatibility contract"
                priority 0
                sealed true
                log (
                    {
                        at 2026-07-29T14:36:52.699420889Z
                        author "brendan@bbqsrc.net"
                        kind @decision
                        text "Define a reviewable compatibility matrix for Ninja build-language semantics, CLI behavior, tool modes, pools, depfiles, dyndeps, logs, jobserver behavior, output ordering, exit status, and version reporting. Preserve Ninja-owned names and wire formats including .ninja_log, .ninja_deps, # ninjadeps, and ninja_required_version. Record SAMUFLAGS as explicitly unsupported. Add the necessary spec rules and attach their ownership to the downstream WBS nodes."
                    }

                    {
                        at 2026-07-29T14:40:23.199458222Z
                        author "brendan@bbqsrc.net"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }

                    {
                        at 2026-07-29T14:42:48.460448631Z
                        author "brendan@bbqsrc.net"
                        kind @decision
                        text "Compatibility oracle pinned to upstream Ninja 1.14.0.git commit b51a1e37c2fb89bbefa600bd155e1ce13983f09d. Ronin owns product identity; Ninja-owned build-language tokens, NINJA_STATUS, tool names, and persistent wire formats remain unchanged. SAMUFLAGS is deliberately outside the compatibility surface. Sixteen cross-cutting requirements are assigned uniquely to downstream WBS owners."
                    }

                    {
                        at 2026-07-29T14:43:16.619792904Z
                        author "brendan@bbqsrc.net"
                        kind @status
                        text "Doing → Done (nplan complete)"
                    }
                )
            }

            {
                id ronin-product-identity
                title "Rename product and CLI to Ronin and remove SAMUFLAGS"
                priority 0
                implements {
                    target-impl (
                        [spec:samurai:req:product.ronin-identity]
                        [spec:samurai:req:product.no-samuflags]
                        [spec:samurai:req:compat.version-reporting]
                        [spec:samurai:req:compat.ninja-owned-names]
                    )
                }
                deps (ronin-compatibility-contract)
                log (
                    {
                        at 2026-07-29T14:36:52.781901212Z
                        author "brendan@bbqsrc.net"
                        kind @note
                        text "Rename the Cargo package, executable, supported library surface, CLI module, diagnostics, documentation, and Ronin-owned test/temp prefixes. Remove SAMUFLAGS lookup, parsing, diagnostics, and tests. Do not introduce a SAMUFLAGS compatibility alias; RONINFLAGS is not required by this scope. Keep Ninja-owned compatibility names unchanged."
                    }

                    {
                        at 2026-07-29T14:44:54.596071969Z
                        author "brendan@bbqsrc.net"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }

                    {
                        at 2026-07-29T14:51:09.159828468Z
                        author "brendan@bbqsrc.net"
                        kind @decision
                        text "Removing SAMUFLAGS intentionally diverges from the C source. The target-side samu.main-fn and samu.parseenvargs-fn rules are bumped to v1 and fully covered/tested; the four v0 source annotations remain stale as historical evidence rather than falsely claiming the C implementation satisfies the Ronin behavior. The product.no-samuflags requirement owns the shipped behavior."
                    }
                )
            }

            {
                id ronin-architecture-decisions
                title "Record core data, parser, scheduler, and I/O architecture decisions"
                priority 0
                deps (ronin-compatibility-contract)
                sealed true
                log (
                    {
                        at 2026-07-29T14:36:52.876176412Z
                        author "brendan@bbqsrc.net"
                        kind @note
                        text "Create AKM elements and decisions covering byte/path representation, typed arena identities, deterministic iteration and output, graph mutation and invalidation, parser ownership, completion-driven scheduling, process supervision, jobserver tokens, output delivery, and Ninja compatibility boundaries."
                    }

                    {
                        at 2026-07-29T15:01:33.259574046Z
                        author "brendan@bbqsrc.net"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }

                    {
                        at 2026-07-29T15:04:46.933024912Z
                        author "brendan@bbqsrc.net"
                        kind @decision
                        text "Registered seven active Ronin boundaries and eight approved decisions. Dense typed Vec arenas and iterative ID-indexed evaluation are selected to address the measured 16.47x Ninja deep-graph regression. The byte frontend operates on exact bytes and spans; Ninja state formats remain interoperability boundaries; process concurrency uses one completion-driven supervisor without a general async runtime; the pinned full Ninja suite remains the release oracle."
                    }

                    {
                        at 2026-07-29T15:04:54.558370385Z
                        author "brendan@bbqsrc.net"
                        kind @status
                        text "Doing → Done (nplan complete)"
                    }
                )
            }

