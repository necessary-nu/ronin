                    {
                        id make-empty-variable-append
                        title "Append to defined-empty variables without a separator"
                        kind @fix
                        deps (make-assignment-modifiers make-build-intent-gate)
                        sealed true
                        log (
                            {
                                at 2026-08-11T10:08:29.948025931Z
                                author "brendan@necessary.nu"
                                kind @note
