    {
        id make-oracle-provenance
        title "Make the recorded Make oracle's identity explicit"
        kind @test
        deps (make-build-intent-gate make-builtin-variable-defaults)
        children (
            {
                id make-oracle-identity-record
                title "Record which Make produced the corpus and let it be chosen"
                kind @test
                implements {
                    target-impl ([spec:ronin:req:make.oracle-provenance])
                }
                log (
                    {
                        at 2026-08-12T13:11:40.936775542Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "Parameterize the recorder's oracle so an arbitrary command — including a wrapper that runs a container — can be measured, and replace the version-string check with a provenance record the corpus carries: version, reported host, prose naming the build, and answers to a fixed probe on which builds of 4.4.1 are known to differ. Recording refuses on any mismatch. Also add a comparison mode that runs the corpus with a chosen Make and reports how it differs from the recording without writing it, which is how a second distribution's build gets classified."
                    }

                    {
                        at 2026-08-12T13:11:57.572967581Z
                        author "brendan@necessary.nu"
                        kind @status
