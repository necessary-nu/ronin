    {
        id ronin-rust-hardening
        title "Harden Ronin's Rust architecture after blind review"
        children (
            {
                id ronin-jobserver-raii
                title "Make GNU Make jobserver transport RAII-safe"
                priority 0
                implements {
                    target-impl ([spec:samurai:req:runtime.jobserver-resource-safety])
                }
                log (
                    {
                        at 2026-07-29T22:58:22.653538743Z
                        author "brendan@bbqsrc.net"
                        kind @note
                        text "Replace Ronin's open/read/write/dup/fcntl bindings and sentinel Slot bookkeeping with a purpose-built jobserver transport or an equally narrow safe abstraction. Do not set O_NONBLOCK on a duplicated shared open-file description. Preserve implicit-token semantics, distinguish WouldBlock/EINTR/EOF/descriptor failures, make explicit tokens unwind-safe, define the release-error policy, eliminate the 1 ms polling loop, and add failure-path tests including inherited-descriptor flag isolation."
                    }

                    {
                        at 2026-07-29T23:06:19.74667249Z
                        author "brendan@bbqsrc.net"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }

                    {
                        at 2026-07-29T23:20:16.129428287Z
                        author "brendan@bbqsrc.net"
                        kind @decision
                        text "Adopt jobserver 0.1.35 as the narrow GNU Make transport boundary. Ronin retains the protocol's implicit slot as a local RAII guard and routes the crate's blocking helper acquisitions into the completion supervisor as typed external events. The crate's Acquired guard returns the exact byte once on Drop; release I/O failures are deliberately non-reportable because Drop must remain infallible and must never retry a possibly completed write. Acquisition and helper-start failures remain observable process errors. Do not add Tokio in this slice: runtime selection remains the measured ronin-runtime-scalability decision, and AsyncFd alone cannot safely make a shared pre-4.4 Make pipe nonblocking."
                    }
                )
            }

            {
                id ronin-persistence-transactions
                title "Make Ninja log rewrites transactionally error-safe"
                priority 0
                log (
                    {
                        at 2026-07-29T22:58:22.699290169Z
                        author "brendan@bbqsrc.net"
                        kind @note
                        text "Make BuildLog and DepsLog updates commit in memory only after complete write, sync, atomic replacement, and successful reopen. Use unique same-directory temporary files, preserve a usable writer after failure, distinguish NotFound from other open errors, avoid mutating graph dependency IDs before durable write success, test injected failures at every stage, and batch flushes where Ninja durability semantics permit."
                    }
                )
            }

