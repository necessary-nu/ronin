            {
                id make-rule-file-sequence-escaped-whitespace
                title "Unquote escaped whitespace while scanning rule file names"
                kind @fix
                deps (make-target-specific-separator-provenance)
                sealed true
                log (
                    {
                        at 2026-08-10T11:54:08.450583619Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "Post-rebase conformance handoff: colon_ws_in_file.mk and colon_ws_in_target.mk expose GNU PARSE_FILE_SEQ whitespace quoting after be221ae fixes their escaped-colon half. File-name sequence scanning must compact each immediate backslash run before a space or tab, keep the blank inside one name after an odd run, and split after an even run; half the slashes remain. Apply the same scanner to rule targets, ordinary prerequisites, and static-pattern target-pattern words without changing deferred prerequisite identity."
                    }

                    {
                        at 2026-08-10T11:54:14.649199973Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }

                    {
                        at 2026-08-10T12:27:12.725309125Z
                        author "brendan@necessary.nu"
                        kind @decision
                        text "Implemented GNU Make's rule file-sequence blank quoting as a zero-copy scanner for ordinary names: an immediate backslash run before space or tab is halved, an odd run keeps the blank inside the name, and an even run leaves it as a separator. Rule targets, immediate prerequisites, static target-pattern words, and fully expanded prerequisite results use the same scanner. Explicit and static second expansion retain and expand the whole prerequisite list; implicit pattern rules first preserve GNU implicit.c get_next_word raw-word boundaries, skipping variable-reference contents and carrying order-only state, then scan each expanded word separately. This prevents a raw trailing backslash from quoting the boundary before the next implicit prerequisite while still accepting an escaped blank introduced by expansion. Five GNU Make 4.4.1-recorded fixtures cover immediate, explicit, implicit decline/success, and static paths; the stale escaped-space target divergence and both colon_ws inventory rows are removed. Independent review APPROVED. Green evidence: Kati all-target tests (101 library, 5 no-global); owned Make oracle 304/304; 387-run conformance (262 raw, 301 normalized, 43 defects and 11 recorded); workspace tests (671 passed, 1 ignored); formatting, diff checks, and clippy with warnings denied; direct/manifest equivalence over 297 Makefiles and 276 graphs with zero disagreements; reproducible 1351-case upstream inventory at 520 unclassified, 68 compiler, 172 interface, and 591 narration; nplan check, lint, comments, and audit. The real-project witness remains independently red only for multiple rules generating build/browse_py.h."
                    }

                    {
                        at 2026-08-10T12:27:12.797857486Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Doing → Done (nplan complete)"
                    }

                    {
                        at 2026-08-10T12:27:56.843700906Z
                        author "brendan@necessary.nu"
                        kind @decision
                        text "The delivered vendored implementation is Kati commit 27b868fec2e007f546e0f85b1ac8288797b258c1, atop separator-provenance correction 3fd635b and rebased original 75a27df."
                        after_done true
                    }
                )
            }

            {
                id make-compatibility-gap-closure
                title "Close known GNU Make build-intent and interface gaps"
                kind @fix
                children (
                    {
                        id make-makefile-set-makeflags
                        title "Decode a MAKEFLAGS a makefile assigns into the switches it names"
                        kind @fix
                        sealed true
                        log (
                            {
                                at 2026-08-09T19:50:25.822176379Z
                                author "brendan@necessary.nu"
                                kind @note
                                text "Measured on make-makeflags-residue-classification, 2026-08-09, against GNU Make 4.4.1 (/usr/bin/make). Found by naming the MAKEFLAGS share of the upstream residue; not fixed there because that node's subject was the classifier.\n\nA makefile that assigns MAKEFLAGS is writing to a switch table, not to a string. GNU Make re-reads the variable after each makefile and decodes the value back through decode_env_switches, then re-renders MAKEFLAGS from the table (define_makeflags, main.c). Ronin stores the literal text, acts on none of it, and renders nothing.\n\nTHREE CONSEQUENCES, each reproduced on its own.\n\n1. The switches never take effect. This is the build-outcome one.\n\n     MAKEFLAGS=-k\n     all: one two\n     one:; @false\n     two:; @echo TWO-RAN\n\n   GNU Make:  `make: *** [d1.mk:3: one] Error 1` / `TWO-RAN` /\n              `make: Target 'all' not remade because of errors.`   rc=2\n   Ronin:     `FAILED: [code=1] one` / `ronin: build stopped: subcommand failed.`   rc=2\n\n   Same status, different work: `two` is never built. -k asked for it. Reproduce this one through the build-intent gate — it is selected work, not narration.\n\n2. A plain assignment discards what the environment and the command line put there. Makefile `MAKEFLAGS=-w`, value read with `$(info $(MAKEFLAGS))`:\n\n     nothing else                GNU `w`                    Ronin `-w`\n     env MAKEFLAGS=-S            GNU `Sw`                   Ronin `-w`\n     command line `hello=world`  GNU `w -- hello=world`     Ronin `-w`\n\n   The `-- hello=world` half is MAKEOVERRIDES, which is how a command-line variable reaches a deeper unit, so this one is graph-affecting and not only spelling.\n\n3. `+=` appends text rather than adding a switch, so nothing is re-rendered and contradicting switches from different origins are never resolved. Makefile `MAKEFLAGS+=--no-print-directory` then `MAKEFLAGS+=-k`, command line `FOO=bar -r -R hello:=world`:\n\n     GNU    `rR --no-print-directory -- hello:=world FOO=bar`\n            then `krR --no-print-directory -- hello:=world FOO=bar`\n     Ronin  `rR -- hello:=world FOO=bar --no-print-directory`\n            then the same with ` -k` on the end\n\n   And with env `MAKEFLAGS=-w` against makefile `MAKEFLAGS+=--no-print-directory`: GNU renders `w`, because the environment beats the makefile (sv 63537); Ronin renders `w --no-print-directory` and so says two opposite things at once.\n\nWHERE IT LANDS\n`record_invocation_variables` in src/make/cli.rs removes the inherited MAKEFLAGS binding so kati can install its own file-origin recursive one, and nothing then reads back what the makefile assigns to it. `make-switch-precedence`'s closing note already carved out the neighbouring question — \"$(MAKEFLAGS) read inside a sub-make's own makefile still reports the parent's raw value, not the merge\" — and names the same two mechanisms (record_invocation's guard, and kati's read_invocation_state importing the process environment during evaluate). This is the other half of it: not what a parent hands down, but what the makefile itself writes.\n\nUPSTREAM SUITE\n28 of the 65 cases still unclassified in variables/MAKEFLAGS after the classifier fix are the -k/-S matrix at tests/scripts/variables/MAKEFLAGS:605-719, which is (1). The suite also asserts (2) and (3) throughout MAKEFLAGS:290-338 and :445-529; those land in makeflags-content, which is an interface observation and not by itself a defect claim."
                            }

                            {
                                at 2026-08-11T10:11:01.11937585Z
                                author "brendan@necessary.nu"
                                kind @note
                                text "sealed — decomposition asserted complete (nplan seal)"
                            }

                            {
                                at 2026-08-11T13:46:39.022589049Z
                                author "brendan@necessary.nu"
                                kind @note
                                text "The Linux headers compatibility loop makes this concrete. At 36860b7, Kbuild's root `MAKEFLAGS += -rR` reaches the semantic self-child as a goal named `-rR` rather than as the no-builtins switches. Its `MAKECMDGOALS` becomes `-rR headers`, Kbuild consequently enables `need-config`, and compilation invents regeneration roots for absent `include/config/auto.conf{,.cmd}`; planning then dies before any recipe. Trace and control isolate the mechanism: GNU Make delegating `scripts/Makefile.build` directly to the same Ronin binary completes `headers`, while Ronin composing the self-child fails. Fix Makefile-assigned MAKEFLAGS decoding and prove both the focused child state and the real `/data/cap9p/linux` target."
                            }

                            {
                                at 2026-08-11T13:46:39.09463582Z
                                author "brendan@necessary.nu"
                                kind @status
                                text "Todo → Doing (nplan start)"
                            }

                            {
                                at 2026-08-11T14:15:28.035547705Z
                                author "brendan@necessary.nu"
                                kind @note
                                text "Delivered GNU Make's special MAKEFLAGS assignment semantics at the evaluator boundary without adding an option parser to Kati. Each effective global write is decoded through Ronin's existing option grammar into a persistent switch table, protected environment/argv switches are reapplied last, MAKEFLAGS and MFLAGS are immediately canonicalized, MAKEOVERRIDES retains its recursive suffix, the normalized state reaches semantic children, and current-build scheduler controls such as -k are updated. Focused unit and process regressions pass; cargo test --workspace --all-targets passes; strict all-feature Clippy passes; direct/manifest equivalence covers 297 Makefiles and 276 graphs with zero disagreements. The real /data/cap9p/linux headers build no longer creates an -rR goal or auto.conf regeneration roots: it compiles 1,034 edges and reaches recipes, exposing the next existing make-newer-prerequisite-automatic-variable gap at KATI_NEW_INPUTS/find FORCE."
                            }

                            {
                                at 2026-08-11T14:15:28.251770985Z
                                author "brendan@necessary.nu"
                                kind @status
                                text "Doing → Done (nplan complete)"
                            }

                            {
                                at 2026-08-11T14:21:42.001193475Z
                                author "brendan@necessary.nu"
                                kind @note
                                text "Post-completion GNU Make 4.4.1 inventory refresh confirms the broad effect: 62 recorded differences disappeared, from 1,368 to 1,306. The bounded classes are now 522 unclassified, 68 compiler candidates, 103 interface observations, and 613 narration observations (previously 522/69/168/609). Most removed rows were MAKEFLAGS content mismatches; one prior no-rule candidate now advances to an ordinary build-result difference. The versioned inventory was updated and its completeness gate passes."
                                after_done true
                            }

                            {
                                at 2026-08-11T14:23:57.786680363Z
                                author "brendan@necessary.nu"
                                kind @note
                                text "The vendored evaluator implementation is Kati commit 842172904589605cd157940790b808fae617aa1d, pushed as origin/nplan/make-makefile-set-makeflags."
                                after_done true
                            }
                        )
                    }

                    {
                        id make-makeflags-in-recipe-environment
                        title "Give a recipe the MAKEFLAGS and MFLAGS GNU Make gives it"
                        kind @fix
                        sealed true
                        log (
                            {
                                at 2026-08-09T19:50:38.792405765Z
                                author "brendan@necessary.nu"
                                kind @note
                                text "Measured on make-makeflags-residue-classification, 2026-08-09, against GNU Make 4.4.1 (/usr/bin/make).\n\n  all:; @echo \"MAKEFLAGS=[$$MAKEFLAGS] MFLAGS=[$$MFLAGS] MAKELEVEL=[$$MAKELEVEL]\"\n\n    invocation          GNU Make 4.4.1                              Ronin\n    (none)              MAKEFLAGS=[] MFLAGS=[] MAKELEVEL=[1]        identical\n    -k V=1              MAKEFLAGS=[k -- V=1] MFLAGS=[-k]            MAKEFLAGS=[] MFLAGS=[]\n    env MAKEFLAGS=-r    MAKEFLAGS=[r] MFLAGS=[-r]                   MAKEFLAGS=[-r] MFLAGS=[]\n    -j2 -k V=1          MAKEFLAGS=[k -j2 --jobserver-auth=fifo:… -- V=1]\n                        MFLAGS=[-k -j2 --jobserver-auth=fifo:…]     MAKEFLAGS=[] MFLAGS=[]\n\nMAKELEVEL agrees everywhere; the other two agree only when there is nothing to say. Three differences: the invocation's own switches never reach the recipe, an inherited value is passed through raw rather than re-rendered (`-r` where GNU writes `r`), and MFLAGS is never set at all.\n\nMECHANISM\n`compilation_context` in src/make/cli.rs builds `recipe_environment` from MAKELEVEL alone. MAKEFLAGS and MFLAGS reach a recipe only through `publication_of` in src/jobserver.rs, which carries the budget words for a jobserver client and nothing else — and the -j2 row above shows that path did not fire here either. `compiler_flag_variables` already renders exactly the string that is wanted: it is what the makefile is told and what a semantic child is handed. It is simply not put in the recipe's environment.\n\nWHY IT MATTERS BEYOND SPELLING\nThis is the value a nested tool reads. libtool, cmake, autotools sub-builds and the kernel's scripts branch on `$MAKEFLAGS` from the environment rather than on `$(MAKEFLAGS)`, and a recipe that shells out to one of them is told nothing about -k, -n, -s or the command-line variables. `make-export-to-recipes`'s opening note assumed MAKELEVEL, MAKEFLAGS and MFLAGS were all literals already in BuildOptions::environment; only MAKELEVEL is.\n\nUPSTREAM SUITE\nExercised at tests/scripts/variables/MAKEFLAGS:54 (`\"\\$$MAKEFLAGS=$$MAKEFLAGS\"`) and :158 (`XX := $(shell echo \"$$MAKEFLAGS\")`). Both now land in makeflags-content, which is an interface observation; this node is the defect claim behind that share of it, and wants a focused reproducer on what a nested tool does differently rather than on the bytes."
                            }

                            {
                                at 2026-08-11T10:11:01.269724374Z
                                author "brendan@necessary.nu"
                                kind @note
                                text "sealed — decomposition asserted complete (nplan seal)"
                            }

                            {
                                at 2026-08-12T07:39:04.98862772Z
                                author "brendan@necessary.nu"
                                kind @status
                                text "Todo → Doing (nplan start)"
                            }

                            {
                                at 2026-08-12T07:44:47.806679836Z
                                author "brendan@necessary.nu"
                                kind @note
                                text "Fixed the package-proven shell-loop case by compiling each unit's final evaluated MAKEFLAGS and MFLAGS into every recipe environment before the existing export/unexport delta. Jobserver publication therefore splices authorization into canonical flags instead of replacing them. Added an integration reproducer with -j2 -k and an empty command-line VALUE assignment; the real nested Make prints VALUE= and never the file default. cargo fmt --all -- --check and all 81 CLI integration tests pass."
                            }

                            {
