platforms (
    {
        platform "rust"
        files (Cargo.toml Cargo.lock src/** kati/Cargo.toml kati/src-rs/** kati/tests/**)
        checks {
            format {
                cmd "cargo fmt --all -- --check"
                fix "cargo fmt --all"
            }
            // The Make frontend is a workspace member, so the default
            // current-package scope would have left it untested and unbuilt by
            // every commit that touched it.
            test {
                cmd "cargo test --workspace --no-fail-fast --quiet"
            }
            check {
                cmd "cargo check --workspace --all-targets --quiet"
            }
        }
    }
)

commit {
    type-prefix "required"
}

adoption {
    scope "porting"
}

quality {
    // func.rs is GNU Make's builtin function table: one function per Make
    // builtin, plus the dispatch entry that names it. A density limit asks
    // "is this file doing too many things", and the answer here is that it
    // does exactly one thing that happens to have sixty cases. Splitting it
    // to satisfy the count would scatter the table without simplifying it.
    exempt-paths (src/build/tests.rs kati/src-rs/func.rs)
    function-density {
        exempt-test-scope true
    }
    duplication {
        exempt-test-scope true
    }
    trivial-function {
        // These compatibility entry points and named conversion helpers
        // intentionally preserve the translated C API.
        allow-names (
            edge_identity
            add_target
            queue
            wanted_edges
            is_empty
            already_up_to_date
            ran_edge
            depswrite
            depsclose
            depsentry
            addvar
            envaddvar
            ruleaddvar
            nodeget
            nodeuse
            explicit
            create_client
            logentry
            write_file
            oschdir
            scanname
            path_bytes
            cleanpath
            cleanedge
            cleantarget
            treeinsert
            warn
            xreallocarray
            xmemdup
            split_string_piece
            join_string_piece
            to_lower_ascii
            equals_case_insensitive_ascii
            formatstatus
        )
    }
}
