// Ronin is the implementation. The C corpus it was ported from has been
// retired from this repository, so the source impl that tracked those symbols
// is gone with it; the requirement text remains the specification, and the
// Rust impl requires both an implementation and a verification site for each
// rule.
specs ({
    name ronin,
    include (docs/spec/**/*.md),
    impls (
        {name target-impl, languages (@rust), include (src/** crates/** tests/** examples/** kati/src-rs/**), exclude (target/**), mode @both}
    )
})
