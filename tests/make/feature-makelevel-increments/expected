oracle GNU Make 4.4.1
outcome success
file Makefile kept 2
| # MAKELEVEL is zero at the top and one deeper at each sub-make.
| all: ; @printf 'level=%s\n' '$(MAKELEVEL)' > top; $(MAKE) --no-print-directory -f sub.mk
file sub touched 1
| level=1
file sub.mk kept 1
| all: ; @printf 'level=%s\n' '$(MAKELEVEL)' > sub
file top touched 1
| level=0
