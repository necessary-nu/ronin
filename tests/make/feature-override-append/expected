oracle GNU Make 4.4.1
outcome success
file Makefile kept 8
| # Appending under override keeps the override; appending without it to a name
| # already overridden is dropped.
| X += x1
| override X += x2
| override Y += y1
| Y += y2
| 
| all: ; @printf '%s|%s\n' '$(X)' '$(Y)' > out
file out touched 1
| x1 x2|y1
