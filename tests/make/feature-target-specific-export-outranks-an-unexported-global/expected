oracle GNU Make 4.4.1
outcome success
file Makefile kept 7
| # The other direction: a global the makefile withdrew, exported again for one
| # target alone.
| V = global
| unexport V
| all: base ; @printf 'all=[%s]\n' "$$V" > all-out
| all: export V = local
| base: ; @printf 'base=[%s]\n' "$$V" > base-out
file all-out touched 1
| all=[local]
file base-out touched 1
| base=[local]
