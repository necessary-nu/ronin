oracle GNU Make 4.4.1
outcome success
file Makefile kept 9
| SHELL := /bin/echo
| NAMED := $(shell hello world)
| SHELL := /bin/sh
| .SHELLFLAGS := -ec
| STOPPED := $(shell false; echo reached)
| STATUS := $(.SHELLSTATUS)
| .SHELLFLAGS := -c
| CONTINUED := $(shell false; echo reached)
| all: ; @printf '%s\n' 'NAMED=[$(NAMED)]' 'STOPPED=[$(STOPPED)]' 'STATUS=[$(STATUS)]' 'CONTINUED=[$(CONTINUED)]' > out
file out touched 4
| NAMED=[-c hello world]
| STOPPED=[]
| STATUS=[1]
| CONTINUED=[reached]
