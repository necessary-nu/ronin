oracle GNU Make 4.4.1
outcome success
file Makefile kept 7
| SHELL := ./recording-shell
| SPACE = $(subst x, ,x)
| EMPTY =
| all:
| 	@$(EMPTY)
| 	-$(EMPTY)
| 	@-$(SPACE)$(SPACE)
file recording-shell kept 4
| #!/bin/sh
| # Records that a shell was started at all, then behaves as one.
| echo started >> shell-ran
| exec /bin/sh "$@"
