oracle GNU Make 4.4.1
status 0
file Makefile kept 3
| # MAKEOVERRIDES holds what was assigned on the command line, and a sub-make
| # reads the same list.
| all: ; @printf '%s\n' '$(MAKEOVERRIDES)' > top; $(MAKE) --no-print-directory -f sub.mk
file sub touched 1
| V=from-cli
file sub.mk kept 1
| all: ; @printf '%s\n' '$(MAKEOVERRIDES)' > sub
file top touched 1
| V=from-cli
