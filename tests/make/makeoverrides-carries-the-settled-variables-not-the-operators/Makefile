# Every command-line assignment operator, and what each settles to. GNU Make
# renders this table from the variable store — the name, a `:` where the
# variable came out simple, `=`, then the stored value — so five spellings come
# back as two, in the reverse of the order the command line introduced them.
all: ; @printf '%s\n' '$(MAKEOVERRIDES)' > overrides.out
